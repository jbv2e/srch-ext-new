{
  "manifest_version": 2,
  "name": "데이터 조회 확장 프로그램",
  "version": "1.0",
  "description": "키를 입력하고 작업 종류를 선택하여 여러 소스에서 데이터를 조회하고 현재 화면에 표시하는 Chrome 확장 프로그램",
  "permissions": ["activeTab", "<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "web_accessible_resources": ["dist/*"],
  "browser_action": {
    "default_popup": "popup.html"
  }
}
